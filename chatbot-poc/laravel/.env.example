# MiMo AI Chatbot - Environment Configuration
# Copy this to your Laravel .env file

# OpenRouter API Key (get from https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# MiMo Model (choose one)
# xiaomi/mimo-v2.5-pro    - Pro model, higher quality
# xiaomi/mimo-v2.5        - Standard model
# xiaomi/mimo-v2.6-pro    - Latest pro model
# xiaomi/mimo-v2.6-flash  - Fast model, lower cost
OPENROUTER_MODEL=xiaomi/mimo-v2.5-pro

# System prompt for the chatbot
MIMO_SYSTEM_PROMPT=Anda adalah asisten AI yang membantu menjawab pertanyaan dengan ramah dan informatif. Jawab dalam Bahasa Indonesia.